[Unit]
Description=AutoBattle Agent game — suspend one card the good decks lean on
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/games/agentgame
EnvironmentFile=/etc/agentgame-round.env

ExecStart=/usr/bin/python3 -u /var/www/games/agentgame/bin/ban.py

# It used to rebuild decks and replay them, which took about five minutes of
# one core; counting cards across a round snapshot takes under a second. The
# limits are kept low anyway -- nobody is waiting on this answer, and the box
# also serves four live games -- but the generous timeout is gone, because a
# run that now takes minutes is a run that has gone wrong.
Nice=18
CPUWeight=20
MemoryMax=300M
TimeoutStartSec=300

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/games/agentgame/var

[Install]
WantedBy=multi-user.target
