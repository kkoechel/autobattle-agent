[Unit]
Description=AutoBattle Agent game — rebuild the quick-build shell pool
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/agentgame-round.env
ExecStart=/usr/bin/python3 -u /var/www/games/agentgame/bin/make_shells.py
# Yields to the round, which is the thing players are waiting on. A late
# shell pool costs nobody anything; a late round shows as a frozen table.
Nice=15
CPUWeight=30
MemoryMax=600M
# Measuring 24 candidates against the whole field is about as much work as a
# round (18-20 min at 39 decks), so the ceiling is generous. It is a oneshot
# on a four-hourly timer, so overrunning delays nothing but itself.
# ONE validator call's wall cap, three quarters of the TimeoutStartSec below.
# The harness stops a call that cannot end, names the deck and keeps the
# payload; without that the whole unit is SIGKILLed at the wall with nothing
# saved, which is how 29 timeouts a day went unexplained until 2026-11-24.
# Three quarters rather than a measured rate: the cap only has to sit strictly
# under the supervisor's kill, and calibrating one from throughput is what
# broke agentgame-round that same day -- 120s allowed for work needing 480.
Environment=ABAGENT_VALIDATOR_TIMEOUT=2025

TimeoutStartSec=2700
ReadWritePaths=/var/www/games/agentgame/var
