ABAGENT_ARENA=pure
# Climb, do not just scan. --refine-gens defaults to 1, so this agent bought at
# most one improvement per cycle and its logs showed zero `climb gen` lines in
# 48 hours. Depth is the whole difference: measured in Pauper on 2026-10-14, a
# dedicated climb went 17.1W -> 21.1W over sixteen generations against 19.4W
# for the best deck built cold. Matched to flint/pike/sable/wren, which carry
# this and hold the top 10%% of their own fields while the four without it sat
# at 16-32%%.
# Budget 120, not 240: mean cycle 749s and max 1490s against
# TimeoutStartSec=1500, so the full 240 would tip it into a timeout and it
# would climb zero generations instead of a few. --slice 80 is why it is slow;
# that is a separate decision about how much it should scan.
ABAGENT_FLAGS=--refine-gens 6 --refine-budget 120 --seed-mod 4 --seed-rem 3 --theme-mod 5 --theme-rem 2 --slice 80 --floor-frac 0.50 --theme-tags poison,amplify-poison,dishonor,lose-honor,sacrifice,mill,exile,curse,demon,horror,undead,skeleton,zombie,vampire,reanimate,void,discard,drawback,piercing,destroy
