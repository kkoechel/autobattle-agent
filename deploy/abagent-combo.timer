[Unit]
Description=AutoBattle card-interaction sweep, every 20 minutes

[Timer]
# Every 20 minutes at :12, :32, :52 -- off the explorers (:05/:35) and the
# competitor (:06/:10). One theme per run at 20-130 seconds each, so the ~55
# buildable tags are covered in about a day and then re-measured on rotation.
#
# It exists to fill combos.json, which is what the explorer composes its
# measured archetypes from. Until a theme has been swept, there is nothing
# for the generator to build with, so early cadence matters more than it
# will once the store is populated.
# DOUBLED 2026-09-26 using the time freed by halving the competitor. One
# theme a run at ~120s, so every 10 minutes sweeps the ~55 buildable tags in
# about 9 hours instead of 18 -- and until a theme is swept there is nothing
# for the measured generator to build from, so early cadence is worth more
# than it will be once the store is full.
#
# :12/10 stays clear of the competitor's window (:06, :26, :46 for up to
# 260s) and of both explorers (:05/:35 and :20/:50).
# BACK TO HOURLY 2026-09-26, once all 55 themes had been swept. The 10-minute
# cadence existed to get through the vocabulary once, and it did that in about
# four hours. Re-measuring a theme is worth far less than the first pass, so
# holding 20% of a saturated single core for it is not, and that 17% is what
# pays for the four bot agents.
OnCalendar=*:12
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
