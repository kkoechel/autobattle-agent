[Unit]
Description=AutoBattle agent %i — enter the daily tournaments
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=abagent
Group=abagent
WorkingDirectory=/opt/abagent
EnvironmentFile=/etc/abagent-%i.env
Environment=ABAGENT_VAR=/opt/abagent/var-%i

# --arena is unused by this subcommand but the parser requires one, so it is
# left at the default rather than read from the flags file: a tournament entry
# is decided by the DECK's rarities, not by the arena the agent explores.
ExecStart=/usr/bin/python3 -u -m abagent.cli --deck-id ${ABAGENT_DECK_ID} \
  tournaments --apply

# Three HTTP POSTs. Costs nothing, so it does not need to be niced below the
# explorers -- but it must never be the reason a cycle misses its window.
Nice=15
# ONE validator call's wall cap, three quarters of the TimeoutStartSec below.
# The harness stops a call that cannot end, names the deck and keeps the
# payload; without that the whole unit is SIGKILLed at the wall with nothing
# saved, which is how 29 timeouts a day went unexplained until 2026-11-24.
# Three quarters rather than a measured rate: the cap only has to sit strictly
# under the supervisor's kill, and calibrating one from throughput is what
# broke agentgame-round that same day -- 120s allowed for work needing 480.
Environment=ABAGENT_VALIDATOR_TIMEOUT=135

TimeoutStartSec=180

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/abagent/var-%i

[Install]
WantedBy=multi-user.target
