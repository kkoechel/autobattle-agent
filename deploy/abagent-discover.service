[Unit]
Description=AutoBattle deck agent — archetype discovery (ShadowDrake second slot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=abagent
Group=abagent
WorkingDirectory=/opt/abagent
EnvironmentFile=/etc/abagent-discover.env

# Its own cache directory. The two agents share code but not state: different
# accounts, different decks, different histories and pass expiries, and one
# var/ would have each silently overwriting the other's.
Environment=ABAGENT_VAR=/opt/abagent/var-discover

# Writes ONLY this account's rental slot, never Golden Hive. That deck is what
# holds rank 1-5, and the rental slot is free precisely because it does -- only
# the better-placing entry is paid. Discovering here costs nothing; discovering
# in the primary would cost the placement.
#
# --seed-mod 2 --seed-rem 0 takes the even half of the card space. The other
# explorer takes the odd half, so the two never generate the same archetypes
# and never spend the shared core learning the same thing twice.
# --theme-mod partitions the measured and combo archetypes across
# agents. These two predate the flag, so both composed all 57 themes,
# produced identical decks, and then each dropped the other's as
# 87-93/100 copies -- the novelty gate working exactly as designed on
# work that should never have been duplicated. The slot stopped
# changing for four hours and only the health check noticed.
ExecStart=/usr/local/bin/abagent-serialise 0 /usr/bin/python3 -u -m abagent.cli --arena pure --deck-id ${ABAGENT_DECK_ID} explore --second-deck-id ${ABAGENT_SECOND_DECK_ID} --slice 40 --theme-mod 5 --theme-rem 4 --seed-mod 2 --seed-rem 0

# Lower priority than the competing agent on both knobs. One core, shared with
# four live games, and that agent was already measured at ~80% duty; this one
# yields to it as well as to apache/php-fpm/mysql.
Nice=15
CPUWeight=10
IOWeight=10

MemoryHigh=400M
MemoryMax=600M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/abagent/var-discover /opt/abagent/bin
# TWO AGENTS AT A TIME. /usr/local/bin/abagent-serialise takes one of two
# exclusive flocks before exec'ing the agent, so a run gets at least half the
# core instead of seven runs each getting a seventh and being killed at the
# wall. Measured 2026-10-31: 42.7% of the core went on runs killed with
# nothing saved.
# Was ONE lock until 2026-11-02, which overcorrected: 218 cycles were skipped
# in 26h while the box sat 43% idle, because one lock admits one job however
# much capacity is free and every timer fires on a fixed minute, so the same
# pairs collided every hour rather than occasionally.
# Exit 75 means "both slots were busy, skipped this cycle" and is a success,
# not a failure.
SuccessExitStatus=75
# The run's own wall, 300s under TimeoutStartSec, so an overrun stops and
# keeps what it measured instead of being killed with nothing saved. Read as
# the default for --deadline. Set here rather than in ExecStart so it sits
# next to the TimeoutStartSec it has to stay under.
Environment=ABAGENT_DEADLINE=1200

TimeoutStartSec=1500

[Install]
WantedBy=multi-user.target
