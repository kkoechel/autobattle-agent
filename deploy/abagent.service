[Unit]
Description=AutoBattle deck agent — one optimisation cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=abagent
Group=abagent
WorkingDirectory=/opt/abagent
EnvironmentFile=/etc/abagent.env
# --deck-id is required: cycle edits and registers that deck unattended, so it
# must never fall back to "whatever deck is active". Set ABAGENT_DECK_ID in
# /etc/abagent.env.
# Do NOT add --repick-complement here. This account's rental slot deck is
# written by abagent-discover.service; cycle only points the slot at it and
# keeps the Double Entry Pass alive. Enabling the complement makes cycle
# overwrite a discovered deck every ten minutes, and it would look like the
# discovery reverting on its own rather than like a conflict.
# Deliberately NO --deepen-gens here. It was measured on this exact deck on
# 2026-10-16 and did not pay: a 10-generation climb produced 2 steps worth
# +0.26W at t=+0.99, well under the gate, and it stalled at generation 3
# because the screen is saturated -- Golden Hive takes 19.4 of 24 screen
# opponents, so most matchups are auto-wins and further gains are invisible
# there. Spending the stall window on it would starve the counter round,
# which screens the LOSING matchups alone and is the right tool for a deck
# whose remaining upside is concentrated in a handful of opponents.
#
# cycle_max was left at its 900 default so the escalations were reachable at
# all: with the old 420 and --budget 260 the entry window shut at 220s elapsed
# while the shortest cycle ever recorded was 260s, and counter_round started
# zero times in 504 cycles over 7 days.
#
# Raised AGAIN to 2400 on 2026-11-11 19:40, after the fresh start replaced
# deck 40806's cloned list with a deck of its own. MEASURED cause, not a
# guess: one evaluation of 1 deck x 21 seeds x 108 opponents costs 54.4s for
# 'Multitude Eternal' against 21.2s for the clone it replaced -- 2.6x, and the
# draws say why (23.4D vs 10.1D, so the games run far longer).
#
# That matters because `sweep_and_confirm` is ONE uninterruptible unit and the
# deadline is only checked at the top of a round and after the order sweep.
# For this deck that unit costs, by the measured rate of 0.024 s per
# deck-seed-opponent:
#
#     screen       7 decks x  21 seeds x 108 opponents =  308s
#     confirm      4 decks x  21 seeds x 108 opponents =  176s
#     validation   2 decks x 161 seeds x 108 opponents =  674s   <- 58%
#                                                        -----
#                                                        1158s
#
# The 19:06 cycle was killed at 1193s, which is that sum plus setup. The same
# unit cost ~297s on the clone, which is exactly where it used to print
# "round1: deadline reached after order". Nothing was wrong with the 1100/1200
# pair; the smallest interruptible block simply grew past it.
#
# KNOWN REMAINING FAULT, not fixed here: one stage_reserve cannot be right for
# stages that cost 335s (counter) and ~1000s (rebase) on the same deck. 500
# keeps counter reachable and lets rebase in slightly early, which is why the
# wall above carries the slack instead. The real fix is a per-stage reserve
# taken from each stage's measured cost.
#
# Raised to 1100 on 2026-11-11, and TimeoutStartSec with it, because 900 did
# not sit UNDER the systemd wall -- it WAS the systemd wall. The process
# measures its ceiling from its own start and systemd from the unit's, so a
# run that reached cycle_max was already being killed: all 19 timeouts over
# 2026-11-06..11 logged "term: signal 15 after 892s" against TimeoutStartSec
# 900. A process ceiling must be strictly below its supervisor's kill, by at
# least the slot wait the serialise wrapper can add.
#
# stage-reserve 500 (the default is 200) is sized from what a stage costs
# rather than from what sounds safe. Over the same window rebase was ENTERED
# 73 times and FINISHED 16: repeatedly admitted with too little time left and
# then abandoned, which spends the core and saves nothing. Measured completion
# is 279s min / 320s median / 496s max, so 500 admits it only when it can
# actually finish.
#
# Together these make room for --climb-budget (180s, the cli.py default added
# the same day). climb had logged "no budget left, skipping" on 127 of 127
# cycles because it shared one deadline object with the joint search, which
# runs first and spent all of it.
ExecStart=/usr/local/bin/abagent-serialise 120 /usr/bin/python3 -u -m abagent.cli --arena pure --deck-id ${ABAGENT_DECK_ID} cycle --budget 260 --second-deck-id ${ABAGENT_SECOND_DECK_ID} --cycle-max 2400 --stage-reserve 500

# subgames-nyc1 is a 1-vCPU box also serving live Reprisal, Ossuary, Mage Wars
# and Blind Wizards. CPUWeight (proportional) rather than CPUQuota (a hard cap)
# so this yields to apache/php-fpm/mysql under contention but still uses the
# core when it is otherwise idle -- which, at load 0.00, is nearly always.
Nice=10
CPUWeight=20
IOWeight=20

# The droplet has NO SWAP, so an unbounded process is an OOM, not a slowdown.
# The validator itself peaks around 17MB; the cap is for the Python side.
MemoryHigh=400M
MemoryMax=600M

# Only needs its own tree and the network.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# var/ holds the caches and the temp payloads the validator reads; bin/ has to
# be writable too, because fetch replaces the validator binary in place when
# the server reports a newer engine. Omitting bin/ works until the day the
# engine is upgraded, and then fails as a read-only filesystem error.
ReadWritePaths=/opt/abagent/var /opt/abagent/bin
# TWO AGENTS AT A TIME. /usr/local/bin/abagent-serialise takes one of two
# exclusive flocks before exec'ing the agent, so a run gets at least half the
# core instead of seven runs each getting a seventh and being killed at the
# wall. Measured 2026-10-31: 42.7% of the core went on runs killed with
# nothing saved.
# Was ONE lock until 2026-11-02, which overcorrected: 218 cycles were skipped
# in 26h while the box sat 43% idle, because one lock admits one job however
# much capacity is free and every timer fires on a fixed minute, so the same
# pairs collided every hour rather than occasionally.
# Exit 75 means "both slots were busy, skipped this cycle" and is a success,
# not a failure.
SuccessExitStatus=75

# 3000, not 2700. The wall must clear cycle_max - stage_reserve + the
# largest stage the agent will admit, because a stage admitted at the last
# legal moment runs its full length past cycle_max: 2400 - 500 + 1000 = 2900.
# A wall at 2700 would kill a legally-admitted rebase, which is the 900-vs-900
# mistake again with bigger numbers.
TimeoutStartSec=3000

[Install]
WantedBy=multi-user.target
