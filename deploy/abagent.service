[Unit]
Description=AutoBattle deck agent — one optimisation cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=abagent
Group=abagent
WorkingDirectory=/opt/abagent
EnvironmentFile=/etc/abagent.env
# --deck-id is required: cycle edits and registers that deck unattended, so it
# must never fall back to "whatever deck is active". Set ABAGENT_DECK_ID in
# /etc/abagent.env.
ExecStart=/usr/bin/python3 -u -m abagent.cli --arena pure --deck-id ${ABAGENT_DECK_ID} cycle --budget 420 --second-deck-id ${ABAGENT_SECOND_DECK_ID}

# subgames-nyc1 is a 1-vCPU box also serving live Reprisal, Ossuary, Mage Wars
# and Blind Wizards. CPUWeight (proportional) rather than CPUQuota (a hard cap)
# so this yields to apache/php-fpm/mysql under contention but still uses the
# core when it is otherwise idle -- which, at load 0.00, is nearly always.
Nice=10
CPUWeight=20
IOWeight=20

# The droplet has NO SWAP, so an unbounded process is an OOM, not a slowdown.
# The validator itself peaks around 17MB; the cap is for the Python side.
MemoryHigh=400M
MemoryMax=600M

# Only needs its own tree and the network.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# var/ holds the caches and the temp payloads the validator reads; bin/ has to
# be writable too, because fetch replaces the validator binary in place when
# the server reports a newer engine. Omitting bin/ works until the day the
# engine is upgraded, and then fails as a read-only filesystem error.
ReadWritePaths=/opt/abagent/var /opt/abagent/bin
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
