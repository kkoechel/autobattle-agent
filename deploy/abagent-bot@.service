[Unit]
Description=AutoBattle bot agent %i — novel-deck discovery on its own account
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=abagent
Group=abagent
WorkingDirectory=/opt/abagent

# One env file and one cache dir per agent. They share the code tree, the
# validator binary and the combo store's findings, but nothing mutable:
# separate accounts, separate decks, separate histories.
EnvironmentFile=/etc/abagent-%i.env
EnvironmentFile=/etc/abagent-%i.flags
Environment=ABAGENT_VAR=/opt/abagent/var-%i

# No --second-deck-id: these accounts own exactly one deck and no Double
# Entry Pass, so the experiment IS the primary deck. --register asserts the
# standing arena registration the provisioner deliberately left off, so a
# placeholder deck never reached a live cohort before the agent wrote to it.
# $ABAGENT_FLAGS, not ${ABAGENT_FLAGS}. systemd splits the first on
# whitespace into separate arguments and passes the second as ONE argument,
# so the braced form hands argparse a single token containing every flag and
# the service dies with "unrecognized arguments".
# ABAGENT_ARENA comes from the flags file. It is NOT defaulted here: an agent
# pointed at the wrong arena builds decks the site refuses, and systemd
# expands an unset ${VAR} to nothing, which makes argparse read the next token
# ("explore") as the arena and die loudly. Loud is the behaviour we want --
# the silent version of this mistake is an agent entering no cohorts at all.
ExecStart=/usr/local/bin/abagent-serialise 0 /usr/bin/python3 -u -m abagent.cli --arena ${ABAGENT_ARENA} --deck-id ${ABAGENT_DECK_ID} \
  explore --register $ABAGENT_FLAGS

# Below the two original agents, which are below the live games. These are
# the most expendable work on a box that samples at 86% busy.
Nice=18
CPUWeight=8
IOWeight=8

MemoryHigh=400M
MemoryMax=600M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/abagent/var-%i /opt/abagent/bin
# ONE AGENT AT A TIME. /usr/local/bin/abagent-serialise takes an exclusive
# flock before exec'ing the agent, so one run gets the whole core instead of
# seven runs each getting a seventh of it and being killed at the wall.
# Measured 2026-10-31: 42.7% of the core went on runs that were killed with
# nothing saved. Exit 75 means "another agent held the core, skipped this
# cycle" and is a success, not a failure.
SuccessExitStatus=75
# The run's own wall, 300s under TimeoutStartSec, so an overrun stops and
# keeps what it measured instead of being killed with nothing saved. Read as
# the default for --deadline. Set here rather than in ExecStart so it sits
# next to the TimeoutStartSec it has to stay under.
Environment=ABAGENT_DEADLINE=1200

TimeoutStartSec=1500

[Install]
WantedBy=multi-user.target
