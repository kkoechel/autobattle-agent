[Unit]
Description=AutoBattle archetype exploration, every 30 minutes

[Timer]
# Every 30 minutes at :05 and :35. The slot now ROTATES each run rather than
# holding a winner, so cadence is directly how fast the agent learns: each
# archetype gets ~3 live cohorts before the next one takes the slot. Hourly
# gave 6 cohorts each and 24 archetypes a day, which is more certainty per
# deck than the offline screen needs and far too few decks.
#
# The :05/:35 offset keeps it off the competing agent's runs (:06/10). They
# share a single core, so the offset is doing real work.
OnCalendar=*:05/30
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
