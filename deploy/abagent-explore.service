[Unit]
Description=AutoBattle deck agent — archetype exploration (second account)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=abagent
Group=abagent
WorkingDirectory=/opt/abagent
EnvironmentFile=/etc/abagent-explore.env

# Its own cache directory. The two agents share code but not state: different
# accounts, different decks, different histories and pass expiries, and one
# var/ would have each silently overwriting the other's.
Environment=ABAGENT_VAR=/opt/abagent/var-explore

# Only ever writes the rental slot. The account's primary deck belongs to a
# person and holds the placement -- and the placement is exactly what makes a
# failed experiment free, since only the better-placing entry is paid.
# --theme-mod partitions the measured and combo archetypes across
# agents. These two predate the flag, so both composed all 57 themes,
# produced identical decks, and then each dropped the other's as
# 87-93/100 copies -- the novelty gate working exactly as designed on
# work that should never have been duplicated. The slot stopped
# changing for four hours and only the health check noticed.
ExecStart=/usr/local/bin/abagent-serialise 0 /usr/bin/python3 -u -m abagent.cli --arena pure --deck-id ${ABAGENT_DECK_ID} explore --second-deck-id ${ABAGENT_SECOND_DECK_ID} --slice 40 --theme-mod 5 --theme-rem 3 --seed-mod 2 --seed-rem 1

# Lower priority than the competing agent on both knobs. One core, shared with
# four live games, and that agent was already measured at ~80% duty; this one
# yields to it as well as to apache/php-fpm/mysql.
Nice=15
CPUWeight=10
IOWeight=10

MemoryHigh=400M
MemoryMax=600M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/abagent/var-explore /opt/abagent/bin
# ONE AGENT AT A TIME. /usr/local/bin/abagent-serialise takes an exclusive
# flock before exec'ing the agent, so one run gets the whole core instead of
# seven runs each getting a seventh of it and being killed at the wall.
# Measured 2026-10-31: 42.7% of the core went on runs that were killed with
# nothing saved. Exit 75 means "another agent held the core, skipped this
# cycle" and is a success, not a failure.
SuccessExitStatus=75
# The run's own wall, 300s under TimeoutStartSec, so an overrun stops and
# keeps what it measured instead of being killed with nothing saved. Read as
# the default for --deadline. Set here rather than in ExecStart so it sits
# next to the TimeoutStartSec it has to stay under.
Environment=ABAGENT_DEADLINE=1200

TimeoutStartSec=1500

[Install]
WantedBy=multi-user.target
